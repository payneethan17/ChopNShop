@page
@model ChopNShop.Pages.ShoppingListModel
@{
    // Sets the browser tab title for this page.
    ViewData["Title"] = "Shopping List";
}
<h1>Shopping List</h1>

@* The "add a new item" form. asp-page-handler="Add" routes this
   specific form's submission to OnPostAdd() in the code-behind,
   rather than a generic default handler. *@
<form method="post" asp-page-handler="Add" class="d-flex mb-4">
    @* asp-for="NewItemName" both names this input correctly for binding
       AND would re-display any previously typed value if the page
       reloaded after a failed submission. *@
    <input type="text" asp-for="NewItemName" class="form-control me-2" placeholder="Add an item..." />
    <button type="submit" class="btn btn-success">Add</button>
</form>

@* Bootstrap's bordered "list-group" styling — gives the shopping list
   that clean, boxed look with dividing lines between items. *@
<ul class="list-group">
@* Loops through every item currently in the shared shopping list,
   building one row (<li>) per item. *@
@foreach (var item in Model.ShoppingItems)
{
    @* d-flex + justify-content-between pushes the checkbox/name to the
       left and the Remove button to the far right, with empty space
       stretching between them. align-items-center keeps everything
       vertically centered within the row. *@
    <li class="list-group-item d-flex justify-content-between align-items-center">

        @* This little form exists ONLY to make the checkbox toggle work.
           asp-page-handler="Toggle" routes its submission to
           OnPostToggle() in the code-behind. *@
        <form method="post" asp-page-handler="Toggle" class="d-flex align-items-center">
            @* Completely invisible on screen, but critical: silently
               carries THIS specific item's Id along with the form, so
               the code-behind knows exactly which item to toggle (since
               there could be many items in the list at once). *@
            <input type="hidden" name="id" value="@item.Id" />
            @* onchange="this.form.submit()" is the one small bit of
               JavaScript on this page — the instant the checkbox is
               clicked, it immediately submits the form it's sitting
               inside of, with no separate "Save" button required.
               checked="@item.IsChecked" controls whether the box starts
               out checked or empty, based on this item's current state. *@
            <input type="checkbox" class="form-check-input me-2" onchange="this.form.submit()" checked="@item.IsChecked" />
            @* The actual item text. The inline style is C# logic deciding
               the look: IF this item is checked, apply a gray strikethrough
               style; OTHERWISE, leave it with no extra styling at all. *@
            <span style="@(item.IsChecked ? "text-decoration: line-through; color: gray;" : "")">@item.Name</span>
        </form>

        @* A separate small form just for the Remove button, routing to
           OnPostRemove() via asp-page-handler="Remove". Kept as its own
           form (rather than combining with the toggle form above) so
           clicking Remove doesn't accidentally also trigger the
           checkbox's auto-submit behavior. *@
        <form method="post" asp-page-handler="Remove">
            @* Same pattern as above — silently carries this item's Id
               along so the code-behind knows which one to delete. *@
            <input type="hidden" name="id" value="@item.Id" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
        </form>
    </li>
}
</ul>

@* Only shown if there are currently zero items in the shopping list —
   gives the user a clear hint instead of just showing an empty box. *@
@if (!Model.ShoppingItems.Any())
{
    <p class="text-muted mt-3">Your list is empty. Add something above!</p>
}