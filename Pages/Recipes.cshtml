@page
@model ChopNShop.Pages.RecipesModel
@{
    ViewData["Title"] = "Recipes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Recipes</h1>
    <a asp-page="/AddRecipe" class="btn btn-success">+ Add Recipe</a>
</div>

<div class="row">
@foreach (var recipe in Model.Recipes)
{
    <div class="col-md-4 mb-4">
        <a asp-page="/RecipeDetails" asp-route-id="@recipe.Id" class="text-decoration-none text-dark">
            <div class="card h-100">
                <img src="@recipe.ImagePath" class="card-img-top" alt="@recipe.Name" style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title">@recipe.Name</h5>
                    <p class="card-text text-muted">
                        Prep time: @recipe.PrepTime.Minutes min | Serves: @recipe.Servings
                    </p>
                </div>
            </div>
        </a>
    </div>
}
</div>

@if (!Model.Recipes.Any())
{
    <p class="text-muted">No recipes yet. Click "+ Add Recipe" to create your first one!</p>
}